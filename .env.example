# Pipeline mode: "mock" (placeholders, no GPU) or "local" (real services)
MODE=mock

# Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ComfyUI
COMFY_URL=http://localhost:8188

# XTTS-v2 narration
XTTS_URL=http://localhost:8020

# MusicGen ambient music
MUSICGEN_URL=http://localhost:8030

# Narration language: en | es | none
LANGUAGE=none

# Video generation model: svd | cogvideox
VIDEO_MODEL=svd

# Output directory (relative to project root)
OUTPUT_DIR=output
